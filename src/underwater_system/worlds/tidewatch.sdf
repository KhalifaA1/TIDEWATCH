      <frame name="sonar_frame" attached_to="base_link">
        <pose>0.527 0 0.11 0 0 0</pose>
      </frame>
      <frame name="hydrophone_frame" attached_to="base_link">
        <pose>0 0 0 0 0 0</pose>
      </frame>
      <!-- Symmetric eight-thruster layout: h0-h3 horizontal, v0-v3 vertical.
           Rotor masses/inertias are deducted from base_link to preserve the
           neutral vehicle mass and original composite rigid-body inertia.
           Each command is a held, reversible force in N; the revolute axes
           are body-frame thrust directions, and their offsets generate torque. -->
      <link name="thruster_0_link">
        <pose relative_to="base_link">0.6 0.25 0 0 0 0</pose>
        <inertial>
          <mass>0.01</mass>
          <inertia>
            <ixx>1e-05</ixx><iyy>1e-05</iyy><izz>1e-05</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <visual name="rotor_hub">
          <geometry><sphere><radius>0.023</radius></sphere></geometry>
          <material><ambient>0.16 0.2 0.22 1</ambient><diffuse>0.16 0.2 0.22 1</diffuse></material>
        </visual>
        <visual name="rotor_blade_a">
          <pose>0 0 0 0 1.5707963267949 -0.785398163397448</pose>
          <geometry><box><size>0.12 0.017 0.006</size></box></geometry>
          <material><ambient>0.15 0.8 0.88 1</ambient><diffuse>0.15 0.8 0.88 1</diffuse></material>
        </visual>
        <visual name="rotor_blade_b">
          <pose>0 0 0 0 1.5707963267949 -0.785398163397448</pose>
          <geometry><box><size>0.017 0.12 0.006</size></box></geometry>
          <material><ambient>0.15 0.8 0.88 1</ambient><diffuse>0.15 0.8 0.88 1</diffuse></material>
        </visual>
      </link>
      <joint name="thruster_0_joint" type="revolute">
        <pose relative_to="thruster_0_link">0 0 0 0 0 0</pose>
        <parent>base_link</parent><child>thruster_0_link</child>
        <axis><xyz>0.707106781186548 -0.707106781186548 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
      </joint>
