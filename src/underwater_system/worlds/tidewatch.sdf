    <model name="auv_2">
      <static>false</static>
      <pose>-3 -5.1961524 -10 0 0 4.1887902</pose>
      <link name="base_link">
        <inertial>
          <mass>233.701617316884</mass>
          <inertia>
            <ixx>5.6533351390686</ixx>
            <iyy>46.6383308164501</iyy>
            <izz>46.6342308164501</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
        <!-- Compact hull displacement proxy: same seawater displacement as
             the initial vehicle; visuals include non-solid open cage space. -->
        <collision name="neutral_displacement">
          <geometry><box><size>1.35 0.7 0.241354102275787</size></box></geometry>
        </collision>
        <visual name="electronics_pod">
          <pose>0 0 0.14 0 0 0</pose>
          <geometry><box><size>0.72 0.4 0.23</size></box></geometry>
          <material><ambient>0.12 0.2 0.25 1</ambient><diffuse>0.12 0.2 0.25 1</diffuse><specular>0.22 0.3 0.35 1</specular><shininess>45</shininess></material>
        </visual>
