<?xml version="1.0"?>
<!-- TIDEWATCH: local assets, meters, Z up; surface 0 m; seabed -20 m.
     AUVs are force-driven by eight reversible maritime thrusters each.
     Scripted diver / intruder / marine-life actors retain body-frame VelocityControl.
     Collision proxies set displacement volumes; total vehicle masses are neutrally buoyant.
     Thruster commands are Newtons, held by native Gazebo Thruster systems.
     Sensor and acoustic modem measurements are generated by the ROS scenario nodes. -->
<sdf version="1.12">
  <world name="tidewatch">
    <gravity>0 0 -9.81</gravity>
    <physics name="underwater_2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1025</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.225</density>
        </density_change>
      </graded_buoyancy>
      <enable>auv_0</enable>
      <enable>auv_1</enable>
      <enable>auv_2</enable>
      <enable>diver</enable>
      <enable>intruder</enable>
      <enable>marine_life</enable>
    </plugin>
    <scene>
      <ambient>0.28 0.47 0.48 1</ambient>
      <background>0.035 0.18 0.24 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
      <fog>
        <color>0.04 0.23 0.27 1</color>
        <type>linear</type>
        <start>25</start>
        <end>115</end>
        <density>0.012</density>
      </fog>
    </scene>
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>TIDEWATCH · underwater protection mission</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.28 0.47 0.48</ambient_light>
        <background_color>0.035 0.18 0.24</background_color>
        <camera_pose>15 -17 -4 0 0.258717411 2.29377568</camera_pose>
        <camera_clip>
          <near>0.15</near>
          <far>220</far>
        </camera_clip>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene manager">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera tracking">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="MarkerManager" name="Marker manager">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="SelectEntities" name="Select entities">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="width">5</property>
          <property type="double" key="height">5</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="x">0</property>
          <property type="double" key="y">0</property>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <property type="string" key="state">floating</property>
          <property type="bool" key="showTitleBar">false</property>
          <property type="double" key="x">300</property>
          <property type="double" key="y">0</property>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>false</iterations>
      </plugin>
      <plugin filename="EntityTree" name="Entity tree">
        <gz-gui>
          <property type="string" key="state">docked_collapsed</property>
        </gz-gui>
      </plugin>
    </gui>
    <light type="directional" name="surface_sun">
      <pose>0 0 2 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.64 0.86 0.91 1</diffuse>
      <specular>0.16 0.26 0.30 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
      <attenuation>
        <range>150</range>
        <constant>0.9</constant>
        <linear>0.002</linear>
        <quadratic>5e-05</quadratic>
      </attenuation>
    </light>
    <light type="point" name="reef_fill">
      <pose>-16 -9 -9 0 0 0</pose>
      <diffuse>0.25 0.52 0.56 1</diffuse>
      <specular>0.1 0.18 0.2 1</specular>
      <attenuation>
        <range>35</range>
        <constant>1</constant>
        <linear>0.015</linear>
        <quadratic>0.004</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light type="point" name="wreck_fill">
      <pose>14 12 -9 0 0 0</pose>
      <diffuse>0.25 0.52 0.56 1</diffuse>
      <specular>0.1 0.18 0.2 1</specular>
      <attenuation>
        <range>35</range>
        <constant>1</constant>
        <linear>0.015</linear>
        <quadratic>0.004</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
